{
  "compilerOptions": {
    "target": "ES6",
    "lib": ["ES2022"],
    "module": "commonjs",
    "esModuleInterop": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "sourceMap": true,
    "noImplicitAny": false,
    "removeComments": true,
    "preserveConstEnums": true,
    "noEmitHelpers": false,
    "outDir": "dist",
    "rootDir": "src",
    "types": ["node", "mocha", "chai"]
  },
  "compileOnSave": true,
  "buildOnSave": true,
  "exclude": ["**/*.spec.ts", "dist", "node_modules"]
}
