{
  "name": "alba",
  "version": "0.0.2",
  "description": "Alba: Reference implementation for CAL Profile in TypeScript",
  "main": "index.js",
  "scripts": {
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "clean": "rimraf dist",
    "build": "npm run clean && npm run lint && tsc -p tsconfig.json",
    "build:w": "tsc -p tsconfig.json -w",
    "lint": "eslint src/**/*.ts",
    "test:tdd": "mocha --reporter min --require ts-node/register \"src/**/*.spec.ts\" \"integration-tests/**/*.spec.ts\" --watch",
    "test": "mocha --recursive --require ts-node/register \"src/**/*.spec.ts\" \"integration-tests/**/*.spec.ts\"",
    "cover": "nyc npm test",
    "coveralls": "nyc npm test && nyc report --reporter=text-lcov | coveralls",
    "start": "ts-node src/index.ts"
  },
  "keywords": [
    "alba",
    "cal"
  ],
  "author": {
    "name": "Pedro J. Molina",
    "url": "http://pjmolina.com"
  },
  "license": "MIT",
  "mocha.options": {
    "compilers": "ts:ts-node/register",
    "mocha.files.glob": [
      "src/**/*.spec.ts",
      "integration-tests/**/*.spec.ts"
    ]
  },
  "mocha.requires": [
    "ts-node/register"
  ],
  "nyc": {
    "include": [
      "src/*.ts",
      "src/**/*.ts"
    ],
    "exclude": [
      "node_modules",
      "typings",
      "src/**/*.spec.ts"
    ],
    "extension": [
      ".ts"
    ],
    "require": [
      "ts-node/register"
    ],
    "reporter": [
      "json",
      "html",
      "text"
    ],
    "all": true
  },
  "devDependencies": {
    "@types/chai": "^5.2.3",
    "@types/express": "^5.0.6",
    "@types/inversify": "^2.0.33",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.2.0",
    "@types/reflect-metadata": "^0.1.0",
    "browserify": "^17.0.1",
    "chai": "^6.2.2",
    "chai-http": "^5.1.2",
    "coveralls": "^3.1.1",
    "eslint": "^10.8.1",
    "mocha": "^11.8.0",
    "mocha-lcov-reporter": "^1.3.0",
    "nyc": "^18.0.0",
    "prettier": "^3.9.6",
    "rimraf": "^6.1.3",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "uglifyjs-folder": "^3.3.0"
  },
  "dependencies": {
    "express": "^5.2.1",
    "inversify": "^8.2.3",
    "reflect-metadata": "^0.2.2"
  }
}
